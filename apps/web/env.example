# =============================================================
# PassportKit — apps/web, local demo template
#
#   cp apps/web/env.example apps/web/.env.local
#
# Nothing here is required: `make demo` sets DEMO_MODE and RPC_URL itself, and
# every actor key below already defaults to the matching well-known anvil dev
# account. Copy this file only when you want to change one of them.
#
# For a hosted (Sepolia) deployment of the product pages, see .env.example —
# that one is the testnet template and does not turn the demo runtime on.
# =============================================================

# --- Demo runtime (server-side, local anvil only) -------------------------
# The /api/demo/* routes answer 403 unless this is exactly "true". It is what
# lights up /markets and /concierge — and what lets anyone who can reach the
# server sign transactions with the actor keys below. Never set it on a public
# deployment.
DEMO_MODE=true

# The chain the demo world lives on. `make demo RPC_PORT=8546` overrides both
# the anvil it starts and this.
RPC_URL=http://127.0.0.1:8545

# Optional block explorer for the tx inspector's "view on explorer" links.
# Blank (the default) means local anvil, so no explorer.
EXPLORER_URL=

# Where DeployAll.s.sol wrote the world. Defaults to apps/web/demo-addresses.json.
# DEMO_ADDRESSES_FILE=

# --- Demo actor keys (server-side, NEVER NEXT_PUBLIC_*) -------------------
# The five actors the demo signs as. Defaults are anvil accounts #0–#4, which
# are public knowledge — that is exactly why DEMO_MODE must stay off anywhere
# that is not your laptop. DeployAll.s.sol reads the same five names, so the
# deploy and the site always agree on who is who.
OPERATOR_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ANA_PK=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
RUI_PK=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
CONCIERGE_PK=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
PLUMBER_PK=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# --- Concierge decider (optional) -----------------------------------------
# "mock" is the deterministic rule set the demo ships with and needs no
# network. "openai" hands each ticket to a model instead; its prose is still
# rendered as text, never as HTML.
# DECIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Point the concierge at a real x402 vendor instead of the built-in mock.
# DEMO_VENDOR_URL=

# --- Browser (public) -----------------------------------------------------
# The NestJS API behind /passport. Not needed for /markets or /concierge.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Set = Privy embedded wallet is the only connect path; blank = MetaMask.
NEXT_PUBLIC_PRIVY_APP_ID=

# Explorer for the product pages' links (the demo pages use EXPLORER_URL).
NEXT_PUBLIC_EXPLORER_URL=

# Reserved: no WalletConnect connector is wired up today, so nothing reads this
# yet. It is here so the name is fixed when one is.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
